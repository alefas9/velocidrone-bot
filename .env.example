# Discord webhook URL του καναλιού σου
# Δημιούργησέ το από: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Φάκελος όπου πέφτουν τα CSV exports από το Velocidrone (in-game leaderboard export)
TRACKS_DIR=./tracks

# Πόσες θέσεις του leaderboard δείχνουμε στα posts
TOP_N=10

# --- ΑΥΤΟΜΑΤΗ ΠΗΓΗ (web) ---
# Πλήρη URLs των tracks που θέλετε να παρακολουθείτε (χωρίςζώντα exports!)
# Πάρτε το URL από το leaderboard του track στο velocidrone.com
# Μορφή: "Ονομα|url;Ονομα2|url2"
TRACK_URLS=
# Ή αφήστε TRACK_URLS κενό και δώστε scenery ids για αυτόματη ανακάλυψη
# (16=Empty Scene Day, 33=Dynamic Weather, 30=Bando, 8=Football Stadium ...)
SCENERY_IDS=

# --- Velocidrone Open API (πλήρες αυτόματο για community tracks) ---
# Bearer token - ρώτα στο Velocidrone FB group / support πώς παίρνεις ένα
VELOCIDRONE_TOKEN=

# --- WebSocket live mode (tournaments) ---
# Το IP του PC που τρέχει το Velocidrone (Websocket Communication: Yes στο sim)
VELO_WS_IP=
